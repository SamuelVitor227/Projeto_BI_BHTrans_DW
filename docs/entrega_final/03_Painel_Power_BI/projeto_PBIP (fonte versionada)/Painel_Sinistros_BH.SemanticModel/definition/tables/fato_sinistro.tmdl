	partition fato_sinistro = m
		mode: import
		source =
				let
				    Fonte = PostgreSQL.Database(Servidor, BancoDeDados),
				    Dados = Fonte{[Schema = "bi", Item = "fato_sinistro"]}[Data],
				    Colunas = Table.SelectColumns(Dados, {"ano", "data", "hora", "sk_local", "sk_tipo_sinistro", "sk_condicao_via", "sk_regional", "qtd_envolvidos", "qtd_vitimas", "qtd_vitimas_fatais", "qtd_veiculos", "qtd_motocicletas", "qtd_automoveis", "qtd_onibus", "qtd_caminhoes", "qtd_bicicletas", "qtd_outros_veiculos", "valor_ups", "velocidade_permitida", "precipitacao_mm", "fl_fatal", "fl_envolve_pedestre", "fl_envolve_motociclista", "fl_geolocalizado", "latitude", "longitude"}),
				    Tipos = Table.TransformColumnTypes(Colunas, {{"ano", Int64.Type}, {"data", type date}, {"hora", Int64.Type}, {"sk_local", Int64.Type}, {"sk_tipo_sinistro", Int64.Type}, {"sk_condicao_via", Int64.Type}, {"sk_regional", Int64.Type}, {"qtd_envolvidos", Int64.Type}, {"qtd_vitimas", Int64.Type}, {"qtd_vitimas_fatais", Int64.Type}, {"qtd_veiculos", Int64.Type}, {"qtd_motocicletas", Int64.Type}, {"qtd_automoveis", Int64.Type}, {"qtd_onibus", Int64.Type}, {"qtd_caminhoes", Int64.Type}, {"qtd_bicicletas", Int64.Type}, {"qtd_outros_veiculos", Int64.Type}, {"valor_ups", Int64.Type}, {"velocidade_permitida", Int64.Type}, {"precipitacao_mm", type number}, {"fl_fatal", type logical}, {"fl_envolve_pedestre", type logical}, {"fl_envolve_motociclista", type logical}, {"fl_geolocalizado", type logical}, {"latitude", type number}, {"longitude", type number}})
				in
				    Tipos

	annotation PBI_ResultType = Table
