/// Fato sinistro: uma linha por boletim de ocorrência.
table fato_sinistro
	lineageTag: 571f5cf0-685e-598a-b860-92f7f5af1ce2

	/// Número de sinistros com vítima (boletins).
	measure Sinistros = COUNTROWS ( 'fato_sinistro' )
		formatString: #,0
		displayFolder: Sinistros
		lineageTag: a3f7c072-e4a9-5aee-81a4-278b3d154524

	/// Sinistros com ao menos uma vítima fatal.
	measure 'Sinistros fatais' = CALCULATE ( [Sinistros], 'fato_sinistro'[fl_fatal] = TRUE () )
		formatString: #,0
		displayFolder: Sinistros
		lineageTag: 86c6b609-9910-582a-90e4-19e130fe6791

	measure 'Sinistros com pedestre' = CALCULATE ( [Sinistros], 'fato_sinistro'[fl_envolve_pedestre] = TRUE () )
		formatString: #,0
		displayFolder: Sinistros
		lineageTag: 8274e39b-c682-5dc3-853a-fcc7cefcf774

	measure 'Sinistros com motocicleta' = CALCULATE ( [Sinistros], 'fato_sinistro'[fl_envolve_motociclista] = TRUE () )
		formatString: #,0
		displayFolder: Sinistros
		lineageTag: a4ee9f99-5078-5814-b3d9-903e6b618b2f

	/// Vítimas (feridos e mortos) contadas no boletim.
	measure 'Vítimas' = SUM ( 'fato_sinistro'[qtd_vitimas] )
		formatString: #,0
		displayFolder: Sinistros
		lineageTag: 3851716d-0462-5c0a-9eca-50699df68cf9

	/// Vítimas fatais registradas nos boletins.
	measure Mortos = SUM ( 'fato_sinistro'[qtd_vitimas_fatais] )
		formatString: #,0
		displayFolder: Sinistros
		lineageTag: b8437936-c7e6-5bad-9201-d1cda0ffeb3f

	measure 'Veículos' = SUM ( 'fato_sinistro'[qtd_veiculos] )
		formatString: #,0
		displayFolder: Sinistros
		lineageTag: c959d353-4081-58e7-b732-aee503fa74ae

	/// Unidade Padrão de Severidade (1, 5 ou 13 por sinistro).
	measure UPS = SUM ( 'fato_sinistro'[valor_ups] )
		formatString: #,0
		displayFolder: Severidade
		lineageTag: d242d056-6780-58cf-9d9d-7b5779f24f40

	measure 'UPS média por sinistro' = DIVIDE ( [UPS], [Sinistros] )
		formatString: 0.00
		displayFolder: Severidade
		lineageTag: 8cd0bd99-2346-5b69-9caf-706a181b3ebc

	/// Letalidade: mortos a cada mil sinistros.
	measure 'Mortos por 1.000 sinistros' = DIVIDE ( [Mortos], [Sinistros] ) * 1000
		formatString: 0.0
		displayFolder: Severidade
		lineageTag: b00e7dc9-ffe1-5549-a2de-429adcdd8f62

	measure '% sinistros geolocalizados' = DIVIDE ( CALCULATE ( [Sinistros], 'fato_sinistro'[fl_geolocalizado] = TRUE () ), [Sinistros] )
		formatString: 0.0%
		displayFolder: Sinistros
		lineageTag: 306aeb07-1b94-574c-841b-bb4828f18a4c

	measure 'Sinistros (ano anterior)' = CALCULATE ( [Sinistros], SAMEPERIODLASTYEAR ( 'dim_calendario'[data] ) )
		formatString: #,0
		displayFolder: Tendência
		lineageTag: 021ad9f1-0cbb-5c0c-9896-f7036729d89a

	measure 'Var. % sinistros vs ano anterior' = DIVIDE ( [Sinistros] - [Sinistros (ano anterior)], [Sinistros (ano anterior)] )
		formatString: 0.0%
		displayFolder: Tendência
		lineageTag: 89e7dbdb-0cc8-5098-b0db-2cccdd4a9894

	measure 'Mortos (ano anterior)' = CALCULATE ( [Mortos], SAMEPERIODLASTYEAR ( 'dim_calendario'[data] ) )
		formatString: #,0
		displayFolder: Tendência
		lineageTag: 617eae9e-41ed-5808-ad14-35e82578bcc7

	measure 'Var. % mortos vs ano anterior' = DIVIDE ( [Mortos] - [Mortos (ano anterior)], [Mortos (ano anterior)] )
		formatString: 0.0%
		displayFolder: Tendência
		lineageTag: 40cc7d74-73ee-5ba7-bb8c-3363ea22a945

	measure Motocicletas = SUM ( 'fato_sinistro'[qtd_motocicletas] )
		formatString: #,0
		displayFolder: Veículos por espécie
		lineageTag: 40c0f1d9-5128-59b9-a280-2ae9fb61c36c

	measure 'Automóveis' = SUM ( 'fato_sinistro'[qtd_automoveis] )
		formatString: #,0
		displayFolder: Veículos por espécie
		lineageTag: 4c49fa5b-ea41-57ce-8562-ee988db11a12

	measure 'Ônibus' = SUM ( 'fato_sinistro'[qtd_onibus] )
		formatString: #,0
		displayFolder: Veículos por espécie
		lineageTag: d6227518-f951-56a6-802d-88a94682fa90

	measure 'Caminhões' = SUM ( 'fato_sinistro'[qtd_caminhoes] )
		formatString: #,0
		displayFolder: Veículos por espécie
		lineageTag: 117fdee5-d6f7-59b5-81c4-6494225d1238

	measure Bicicletas = SUM ( 'fato_sinistro'[qtd_bicicletas] )
		formatString: #,0
		displayFolder: Veículos por espécie
		lineageTag: c2256b47-8e47-5bb3-93fd-df9b461175ff

	measure 'Outros veículos' = SUM ( 'fato_sinistro'[qtd_outros_veiculos] )
		formatString: #,0
		displayFolder: Veículos por espécie
		lineageTag: 79a93aaa-b9ec-5129-984c-8470017ec2c0

	measure 'Sinistros/ano no primeiro triênio' =
			VAR a0 = CALCULATE ( MIN ( 'fato_sinistro'[ano] ), REMOVEFILTERS ( 'dim_calendario' ) )
			RETURN DIVIDE ( CALCULATE ( [Sinistros], REMOVEFILTERS ( 'dim_calendario' ), 'dim_calendario'[ano] >= a0 && 'dim_calendario'[ano] <= a0 + 2 ), 3 )
		formatString: 0.0
		displayFolder: Tendência
		lineageTag: 4b479473-0207-562a-957f-152be66898b3

	measure 'Sinistros/ano no último triênio' =
			VAR a1 = CALCULATE ( MAX ( 'fato_sinistro'[ano] ), REMOVEFILTERS ( 'dim_calendario' ) )
			RETURN DIVIDE ( CALCULATE ( [Sinistros], REMOVEFILTERS ( 'dim_calendario' ), 'dim_calendario'[ano] >= a1 - 2 && 'dim_calendario'[ano] <= a1 ), 3 )
		formatString: 0.0
		displayFolder: Tendência
		lineageTag: 2bd2972c-c96a-5f5c-9726-b2e3437b6e2c

	/// Crescimento da média anual de sinistros entre o primeiro e o último triênio da série.
	measure 'Variação % entre triênios' = DIVIDE ( [Sinistros/ano no último triênio] - [Sinistros/ano no primeiro triênio], [Sinistros/ano no primeiro triênio] )
		formatString: 0.0%
		displayFolder: Tendência
		lineageTag: 1dc96580-dcad-5742-860f-83a0fb40c891

	/// Vermelho = cresceu; verde = caiu.
	measure 'Cor da variação' = IF ( [Variação % entre triênios] > 0, "#B03A2E", "#2E7D5B" )
		displayFolder: Tendência
		lineageTag: 8b76cf76-c3eb-569c-a0f9-4c3804625036

