/// Fato envolvido: uma linha por pessoa envolvida no sinistro.
table fato_envolvido
	lineageTag: 2e258bb3-b6e4-51ad-b127-354d17dab5a7

	measure Envolvidos = COUNTROWS ( 'fato_envolvido' )
		formatString: #,0
		displayFolder: Pessoas
		lineageTag: 8129805f-8099-5cc6-b4bd-5cf781ee6759

	/// Use com dim_pessoa e dim_veiculo.
	measure 'Vítimas (pessoas)' = CALCULATE ( [Envolvidos], 'fato_envolvido'[fl_vitima] = TRUE () )
		formatString: #,0
		displayFolder: Pessoas
		lineageTag: e4bc81aa-514e-59d3-b780-eed35fd9828a

	/// Use com dim_pessoa e dim_veiculo.
	measure 'Mortos (pessoas)' = CALCULATE ( [Envolvidos], 'fato_envolvido'[fl_vitima_fatal] = TRUE () )
		formatString: #,0
		displayFolder: Pessoas
		lineageTag: d1ca7935-bd8d-5e02-94d9-95d0031c9a33

	measure 'Vítimas pedestres' = CALCULATE ( [Vítimas (pessoas)], 'fato_envolvido'[fl_pedestre] = TRUE () )
		formatString: #,0
		displayFolder: Pessoas
		lineageTag: 75599f56-1c95-5ecc-9020-b740cdb7e11a

	measure 'Vítimas motociclistas' = CALCULATE ( [Vítimas (pessoas)], 'fato_envolvido'[fl_motociclista] = TRUE () )
		formatString: #,0
		displayFolder: Pessoas
		lineageTag: 7df0a5c9-ab0f-59b1-9557-4fe72bda49a8

	measure '% vítimas pedestres' = DIVIDE ( [Vítimas pedestres], [Vítimas (pessoas)] )
		formatString: 0.0%
		displayFolder: Pessoas
		lineageTag: e72283f4-2b6c-5593-b1b1-d4509b696891

	measure '% vítimas motociclistas' = DIVIDE ( [Vítimas motociclistas], [Vítimas (pessoas)] )
		formatString: 0.0%
		displayFolder: Pessoas
		lineageTag: 33451315-8afc-5318-b93e-ba0d5ff2b5a7

	measure 'Mortos pedestres' = CALCULATE ( [Mortos (pessoas)], 'fato_envolvido'[fl_pedestre] = TRUE () )
		formatString: #,0
		displayFolder: Pessoas
		lineageTag: ac729e21-41e4-5550-b8b8-e6e906a4ebb4

	measure 'Mortos motociclistas' = CALCULATE ( [Mortos (pessoas)], 'fato_envolvido'[fl_motociclista] = TRUE () )
		formatString: #,0
		displayFolder: Pessoas
		lineageTag: f5035dfe-c035-58f7-b9f4-49df6c60835d

	measure '% mortos pedestres' = DIVIDE ( [Mortos pedestres], [Mortos (pessoas)] )
		formatString: 0.0%
		displayFolder: Pessoas
		lineageTag: 979c3252-17ba-58de-a6c8-c34e4685ac61

	measure '% mortos motociclistas' = DIVIDE ( [Mortos motociclistas], [Mortos (pessoas)] )
		formatString: 0.0%
		displayFolder: Pessoas
		lineageTag: 1a649d78-228b-54c8-98b8-d810b8a0b150

	measure 'Idade média' = AVERAGE ( 'fato_envolvido'[idade] )
		formatString: 0.0
		displayFolder: Pessoas
		lineageTag: a0a147c3-16d2-5965-9f47-c86b91bd8b8e

