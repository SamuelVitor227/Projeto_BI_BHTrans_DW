	/// Usuário da via derivado do tipo de envolvimento e da espécie do veículo.
	column usuario_via =
			VAR especie = RELATED ( 'dim_veiculo'[grupo_especie] )
			RETURN
			    SWITCH (
			        TRUE (),
			        'fato_envolvido'[fl_pedestre], "Pedestre",
			        'fato_envolvido'[fl_motociclista] || especie = "Motocicleta", "Motociclista",
			        especie = "Bicicleta", "Ciclista",
			        especie = "Automóvel/utilitário", "Ocupante de automóvel",
			        especie = "Ônibus", "Ocupante de ônibus",
			        especie = "Caminhão", "Ocupante de caminhão",
			        "Outro / não identificado"
			    )
		dataType: string
		lineageTag: 459e3c56-2463-539e-8fdd-24f03e92ee88
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	partition fato_envolvido = m
		mode: import
		source =
				let
				    Fonte = PostgreSQL.Database(Servidor, BancoDeDados),
				    Dados = Fonte{[Schema = "bi", Item = "fato_envolvido"]}[Data],
				    Colunas = Table.SelectColumns(Dados, {"ano", "data", "hora", "sk_local", "sk_pessoa", "sk_veiculo", "sk_regional", "sk_tipo_sinistro", "sk_condicao_via", "idade", "gravidade", "fl_vitima", "fl_vitima_fatal", "fl_pedestre", "fl_motociclista", "fl_condutor"}),
				    Tipos = Table.TransformColumnTypes(Colunas, {{"ano", Int64.Type}, {"data", type date}, {"hora", Int64.Type}, {"sk_local", Int64.Type}, {"sk_pessoa", Int64.Type}, {"sk_veiculo", Int64.Type}, {"sk_regional", Int64.Type}, {"sk_tipo_sinistro", Int64.Type}, {"sk_condicao_via", Int64.Type}, {"idade", Int64.Type}, {"gravidade", type text}, {"fl_vitima", type logical}, {"fl_vitima_fatal", type logical}, {"fl_pedestre", type logical}, {"fl_motociclista", type logical}, {"fl_condutor", type logical}})
				in
				    Tipos

	annotation PBI_ResultType = Table
